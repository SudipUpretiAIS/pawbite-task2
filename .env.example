# Copy to .env for LOCAL use; never commit .env.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=sqlite:///shop.db
APP_ENV=development
COOKIE_SECURE=false
# Cloud settings: APP_ENV=production and COOKIE_SECURE=true
# DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@HOST:5432/DATABASE?sslmode=require
